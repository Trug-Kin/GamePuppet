--- !u!114 &12317179
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 12317177}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7f8974143e214645b678230bd5b2c7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DaoCuKeChuyenV40
  story: {fileID: 1466382736}
  heading: "BI\xCAN B\u1EA2N H\u1ECCP KHOA"
  text: "M\u1EE5c 4: Ki\u1EBFn ngh\u1ECB b\u1ED5 sung c\u1ED9t nh\u1EADn x\xE9t cho b\xE0i l\xE0m c\xF3 c\xE1ch gi\u1EA3i kh\xE1c.\n\n\xDD ki\u1EBFn: bi\u1EC3u m\u1EABu hi\u1EC7n t\u1EA1i thu\u1EADn ti\u1EC7n cho th\u1ED1ng k\xEA. N\u1EBFu m\u1EDF th\xEAm c\u1ED9t, c\u1EA7n th\u1ED1ng nh\u1EA5t ti\xEAu ch\xED gi\u1EEFa c\xE1c l\u1EDBp. Quy\u1EBFt \u0111\u1ECBnh: \u0111\u1EC3 h\u1ECDc k\u1EF3 sau.\n\nB\xEAn d\u01B0\u1EDBi c\xF3 m\u1ED9t trang vi\u1EBFt tay, kh\xE1c m\xE0u m\u1EF1c: \u2018T\xF4i \u0111\xE3 \u0111\u1EC1 ngh\u1ECB ba l\u1EA7n. L\u1EA7n th\u1EE9 t\u01B0 t\xF4i kh\xF4ng \u0111\u01B0a tay n\u1EEFa. Kh\xF4ng ai b\u1EA3o t\xF4i im. T\xF4i t\u1EF1 hi\u1EC3u bu\u1ED5i h\u1ECDp s\u1EBD k\u1EBFt th\xFAc s\u1EDBm h\u01A1n.\u2019\n\nNh\u1EEFng trang n\u0103m sau v\u1EABn \u0111\u01B0\u1EE3c \u0111\xF3ng c\xF9ng m\u1ED9t lo\u1EA1i ghim. T\xEAn ng\u01B0\u1EDDi ghi bi\xEAn b\u1EA3n thay \u0111\u1ED5i. D\xF2ng quy\u1EBFt \u0111\u1ECBnh \u0111\u01B0\u1EE3c ch\xE9p l\u1EA1i nguy\xEAn v\u1EB9n."
