--- !u!114 &1940139690
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1940139688}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7f8974143e214645b678230bd5b2c7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DaoCuKeChuyenV40
  story: {fileID: 1466382736}
  heading: "NH\u1EACT K\xDD TH\u1EF0C T\u1EACP"
  text: "Th\u1EE9 t\u01B0. Em h\u1ECDc sinh ng\u1ED3i cu\u1ED1i l\u1EDBp ch\u1ECDn m\u1ED9t ngh\u1EC1 m\xE0 c\u1EA3 nh\xE0 em ph\u1EA3n \u0111\u1ED1i. M\xECnh \u0111\xE3 \u0111\u1ECBnh n\xF3i \u2018c\u1EE9 nghe b\u1ED1 m\u1EB9 tr\u01B0\u1EDBc \u0111i\u2019. M\xECnh d\u1EEBng l\u1EA1i v\xE0 h\u1ECFi em \u0111\xE3 t\xECm hi\u1EC3u c\xF4ng vi\u1EC7c \u1EA5y \u0111\u1EBFn \u0111\xE2u.\n\nEm k\u1EC3 \u0111\u01B0\u1EE3c c\u1EA3 nh\u1EEFng vi\u1EC7c kh\xF3 ch\u1ECBu nh\u1EA5t c\u1EE7a ngh\u1EC1. M\xECnh kh\xF4ng bi\u1EBFt em s\u1EBD ch\u1ECDn \u0111\xFAng hay sai. L\u1EA7n \u0111\u1EA7u ti\xEAn trong tu\u1EA7n, m\xECnh kh\xF4ng c\u1ED1 quy\u1EBFt \u0111\u1ECBnh thay em.\n\nCu\u1ED1i trang, Minh ghi nh\u1ECF: \u2018Khi m\xECnh n\xF3i m\u1ED9t ng\u01B0\u1EDDi ch\u01B0a \u0111\u1EE7 l\u1EDBn \u0111\u1EC3 t\u1EF1 ch\u1ECDn, m\xECnh \u0111ang b\u1EA3o v\u1EC7 ng\u01B0\u1EDDi \u0111\xF3 hay \u0111ang tr\xE1nh tr\xE1ch nhi\u1EC7m ph\u1EA3i l\u1EAFng nghe?\u2019\n\nM\u1ED9t v\u1EC7t c\xE0 ph\xEA c\u1EAFt ngang c\xE2u cu\u1ED1i. Trang ti\u1EBFp theo c\xF2n tr\u1EAFng."
