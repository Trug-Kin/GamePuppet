--- !u!114 &569138166
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 569138164}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7f8974143e214645b678230bd5b2c7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DaoCuKeChuyenV40
  story: {fileID: 1466382736}
  heading: "TH\u01AF CH\u01AFA G\u1EECI"
  text: "C\xF4 Mai,\n\nEm vi\u1EBFt th\u01B0 n\xE0y sau bu\u1ED5i th\u1EF1c t\u1EADp \u0111\u1EA7u ti\xEAn. C\xF3 m\u1ED9t em h\u1ECFi t\u1EA1i sao ph\u1EA3i ch\xE9p l\u1EA1i \u0111i\u1EC1u \u0111\xE3 in trong s\xE1ch. Em \u0111\xE3 b\u1EA3o em \u1EA5y c\u1EE9 l\xE0m nh\u01B0 c\xE1c b\u1EA1n. N\xF3i xong em m\u1EDBi nh\u1EADn ra m\xECnh t\u1EEBng gh\xE9t c\xE2u tr\u1EA3 l\u1EDDi \u1EA5y.\n\nH\xF4m nay em th\u1EED \u0111\u1EC3 tr\u1ED1ng m\u01B0\u1EDDi ph\xFAt cu\u1ED1i gi\u1EDD. Kh\xF4ng ai h\u1ECFi g\xEC. Em th\u1EA5y s\u1EE3 kho\u1EA3ng tr\u1ED1ng \u0111\xF3, n\xEAn l\u1EA1i l\u1EA5y b\xE0i t\u1EADp ra. C\xF3 l\u1EBD cho ph\xE9p ng\u01B0\u1EDDi kh\xE1c h\u1ECFi ch\u01B0a \u0111\u1EE7. M\xECnh c\xF2n ph\u1EA3i ch\u1EA5p nh\u1EADn kh\xF4ng tr\u1EA3 l\u1EDDi \u0111\u01B0\u1EE3c ngay.\n\nEm ch\u01B0a g\u1EEDi th\u01B0. Em kh\xF4ng bi\u1EBFt \u0111ang mu\u1ED1n xin c\xF4 tha th\u1EE9, hay mu\u1ED1n c\xF4 b\u1EA3o em \u0111\xE3 l\xE0m \u0111\xFAng."
