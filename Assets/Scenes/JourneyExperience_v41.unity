--- !u!114 &221787365
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 221787363}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7f8974143e214645b678230bd5b2c7d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DaoCuKeChuyenV40
  story: {fileID: 1466382736}
  heading: "T\u1EDC GI\u1EA4Y C\u1EE6A M\u1EB8"
  text: "M\u1EB9 \u0111\u1EC3 \xEDt ti\u1EC1n trong t\xFAi \xE1o. Kh\xF4ng nhi\u1EC1u \u0111\xE2u, th\xE1ng n\xE0y m\u01B0a qu\xE1. Con c\u1EE9 \u0103n u\u1ED1ng cho \u0111\u1EE7.\n\nN\u1EBFu c\xF3 chuy\u1EC7n g\xEC kh\xF3 n\xF3i, c\u1EE9 g\u1ECDi v\u1EC1. M\u1EB9 c\xF3 th\u1EC3 kh\xF4ng hi\u1EC3u ngay, nh\u01B0ng m\u1EB9 v\u1EABn mu\u1ED1n nghe.\n\nPh\xEDa sau l\xE0 danh s\xE1ch ti\u1EC1n tr\u1ECD, h\u1ECDc ph\xED v\xE0 gi\u1EDD l\xE0m th\xEAm. Minh \u0111\xE3 c\u1ED9ng l\u1EA1i ba l\u1EA7n. K\u1EBFt qu\u1EA3 kh\xF4ng thay \u0111\u1ED5i. D\xF2ng \u2018g\u1ECDi v\u1EC1 nh\xE0\u2019 kh\xF4ng \u0111\u01B0\u1EE3c ghi v\xE0o danh s\xE1ch."
